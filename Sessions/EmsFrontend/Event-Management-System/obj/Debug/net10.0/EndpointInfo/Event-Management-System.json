          },
          "attendeeId": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "event": {
            "$ref": "#/components/schemas/Event"
          },
          "attendee": {
            "$ref": "#/components/schemas/User"
          }
        }
      },
      "EventDTO": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "startDate": {
            "type": "string",
            "format": "date"
          },
          "category": {
            "type": "string"
          },
          "ticketPrice": {
            "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d+)?(?:[eE][+-]?\\d+)?$",
            "type": [
              "number",
              "string"
            ],
            "format": "double"
          }
        }
      },
      "EventUpdateDTO": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "newName": {
            "type": "string"
          },
          "startDate": {
            "type": "string",
            "format": "date"
          },

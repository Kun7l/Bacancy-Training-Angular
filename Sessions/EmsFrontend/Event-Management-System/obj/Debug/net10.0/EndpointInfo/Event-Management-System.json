  "components": {
    "schemas": {
      "Event": {
        "type": "object",
        "properties": {
          "id": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "name": {
            "type": "string"
          },
          "startDate": {
            "type": "string",
            "format": "date"
          },
          "category": {
            "type": "string"
          },
          "ticketPrice": {
            "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d+)?(?:[eE][+-]?\\d+)?$",
            "type": [
              "number",
              "string"
            ],
            "format": "double"
          },
          "createdBy": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "eventAttendees": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/EventAttendee"
            }
          }
        }
      },
      "EventAttendee": {
        "type": "object",
        "properties": {
          "eventId": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
